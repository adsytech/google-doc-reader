{
  "name": "Adsytech/google-doc-reader",
  "description": "Google Docs HTML reader and sanitizer.",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Adsytech"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-libxml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Adsytech\\GoogleDocReader\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Adsytech\\GoogleDocReader\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
